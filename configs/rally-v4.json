{
  "environment_version": "rally-v4",
  "reward_version": "v4",
  "level_id": "N4",
  "experiment": {
    "hypothesis": "En pistas que cambian en cada carrera, un agente PPO con red neuronal (que ve los obstáculos con sensores) completa al menos el 70% de las vueltas en pistas nunca vistas, mientras que Q-learning con estados discretizados no pasa del 30%.",
    "change_vs_previous": "v3 -> v4: física continua (velocidad en m/s, aceleración, fricción por terreno, giro con modelo de bicicleta, saltos con gravedad, caída del puente), acciones continuas de acelerar/frenar y girar como pide la guía, sensores de distancia a bordes y de obstáculos adelante, checkpoints cada 50 m, vallas que frenan en seco y una pista distinta en cada episodio. Cambian observaciones y acciones: familia de modelos nueva.",
    "selection_criteria": {"min_success_rate": 0.7, "min_success_margin_over_qlearning": 0.3}
  },
  "track": {
    "straight_m": 300,
    "radius_m": 80,
    "lanes": 4,
    "lane_width_m": 4.0,
    "cell_m": 10,
    "checkpoint_every_m": 50,
    "start_clear_m": 40,
    "finish_clear_m": 30
  },
  "physics": {
    "dt_s": 0.25,
    "substeps": 5,
    "gravity_mps2": 9.81,
    "max_speed_mps": 35,
    "max_accel_mps2": 6.0,
    "max_brake_mps2": 9.0,
    "drag_per_v2": 0.0008,
    "wheelbase_m": 2.7,
    "max_steer_rad": 0.35,
    "ramp_angle_deg": 20,
    "ramp_height_m": 1.2,
    "deck_height_m": 3.0,
    "landing_lip_m": 0.6,
    "hard_landing_vz_mps": 12.0,
    "barrier_length_m": 2.0,
    "barrier_crash_speed_mps": 6.0,
    "fall_accident_drop_m": 2.0,
    "initial_fuel_l": 40,
    "fuel_idle_l_per_s": 0.08,
    "fuel_throttle_l_per_s": 0.32
  },
  "terrains": {
    "tierra":    {"code": ".", "grip": 0.90, "rolling": 0.015, "color": "#d98a58"},
    "lodo":      {"code": "L", "grip": 0.55, "rolling": 0.30,  "color": "#5a3b24"},
    "agua":      {"code": "A", "grip": 0.30, "rolling": 0.04,  "color": "#2f86d6"},
    "pasto":     {"code": "S", "grip": 0.60, "rolling": 0.10,  "color": "#9fbf2e"},
    "foso":      {"code": "F", "grip": 0.0,  "rolling": 0.0,   "color": "#17110e"},
    "rampa":     {"code": "R", "grip": 0.90, "rolling": 0.015, "color": "#b9622f"},
    "valla":     {"code": "B", "grip": 0.90, "rolling": 0.015, "color": "#d8332a"}
  },
  "generator": {
    "section_m": 100,
    "min_free_lanes_per_section": 1,
    "patch_probabilities": {"lodo": 0.22, "agua": 0.18, "pasto": 0.15, "valla": 0.16, "rampa_foso": 0.10, "nada": 0.19},
    "patch_length_cells": [1, 3],
    "bridge_probability": 0.6,
    "bridge_length_cells": [6, 9],
    "bridge_gap_m": 6
  },
  "sensors": {
    "lookahead_cells": 6,
    "features_per_cell": ["peligro", "rampa", "frena", "agarre", "puente"]
  },
  "perturbations": {
    "lluvia": {"descripcion": "Lluvia: todo el agarre baja un 30% y el lodo frena un 30% más.", "grip_factor": 0.7, "rolling_factor": 1.3},
    "sensor_ruidoso": {"descripcion": "Sensores con ruido gaussiano (desviación 0,1) en cada lectura.", "obs_noise_std": 0.1}
  },
  "reward": {
    "per_meter": 0.05,
    "checkpoint": 0.5,
    "step": -0.02,
    "accident": -5.0,
    "stalled": -10.0,
    "finish": 30.0,
    "remaining_fuel_per_l": 0.2
  },
  "episode": {"max_steps": 600, "max_accidents": 5, "stall_steps": 40},
  "training": {
    "seeds": [7, 21, 42],
    "ppo": {"total_timesteps": 1000000, "n_envs": 4, "n_steps": 512, "batch_size": 256, "n_epochs": 10, "learning_rate": 0.0003, "gamma": 0.99, "gae_lambda": 0.95, "clip_range": 0.2, "ent_coef": 0.005, "log_std_init": -0.5, "net_arch": [64, 64], "eval_every_steps": 50000, "eval_layouts_during_training": 5},
    "qlearning": {"alpha": 0.2, "gamma": 0.98, "epsilon_start": 1.0, "epsilon_end": 0.05, "speed_bins": [3, 8, 14, 20, 26], "psi_bins": [-0.12, 0.12]},
    "train_layout_seed_offset": 0,
    "evaluation_episodes": 30,
    "evaluation_layout_seed_offset": 100000
  },
  "tracking": {"experiment_name": "autonomous-rally-v4"}
}
