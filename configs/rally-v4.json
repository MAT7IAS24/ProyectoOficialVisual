  "training": {
    "episodes": 4000,
    "alpha": 0.25,
    "gamma": 0.97,
    "epsilon_start": 1.0,
    "epsilon_end": 0.05,
    "seed": 7,
    "seeds": [7, 21, 42],
    "weather_mix_probability": 0.5,
