{
  "environment_version": "rally-v4",
  "reward_version": "v4",
  "level_id": "N4",
  "experiment": {
    "hypothesis": "Conservar Q-learning y hacer observable el estado interno que afecta la dinámica, el horizonte y las recompensas reducirá las decisiones inconsistentes entre situaciones previamente aliasadas; entrenar con clima mixto debe mantener rendimiento en pista normal y lluvia.",
    "change_vs_previous": "v3 -> v4: se mantienen pista, terrenos y acciones; el estado añade combustible exacto, accidentes acumulados, pasos, mejor tramo alcanzado y condición meteorológica. Q-learning usa almacenamiento disperso para evitar asignar una tabla densa enorme. Las semillas se entrenan con clima mixto.",
    "selection_criteria": {
      "min_success_rate_normal": 0.9,
      "min_success_rate_rain": 0.9
    }
  },
  "environment": {
    "track_length_meters": 3000,
    "segment_meters": 100,
    "lanes": 4,
    "initial_lane": 1,
    "random_start_lane": true,
    "initial_speed_level": 0,
    "max_speed_level": 3,
    "initial_fuel": 150,
    "fuel_base_cost": 2,
    "fuel_speed_cost": 3,
    "fuel_lane_change_cost": 1,
    "fuel_bucket_thresholds": [40, 80, 120],
    "lane_change_max_speed": 2,
    "max_accidents": 4,
    "accident_rollback_segments": 1,
    "max_steps": 100,
    "actions": [
      {"name": "frenar", "speed_delta": -1, "lane_delta": 0},
      {"name": "mantener", "speed_delta": 0, "lane_delta": 0},
      {"name": "acelerar", "speed_delta": 1, "lane_delta": 0},
      {"name": "carril_izquierda", "speed_delta": 0, "lane_delta": -1},
      {"name": "carril_derecha", "speed_delta": 0, "lane_delta": 1}
    ],
    "terrains": [
      {"id": 0, "code": ".", "name": "asfalto", "kind": "free"},
      {"id": 1, "code": "L", "name": "lodo", "kind": "slow", "speed_cap": 1},
      {"id": 2, "code": "A", "name": "agua", "kind": "skid", "safe_speed": 2},
      {"id": 3, "code": "S", "name": "sin_pista", "kind": "slow", "speed_cap": 2},
      {"id": 4, "code": "F", "name": "foso", "kind": "pit"},
      {"id": 5, "code": "B", "name": "barril", "kind": "barrel"},
      {"id": 6, "code": "R", "name": "rampa", "kind": "ramp", "min_speed": 2, "slow_cap": 1, "barrel_on_ramp": false},
      {"id": 7, "code": "K", "name": "rampa_con_barril", "kind": "ramp", "min_speed": 2, "slow_cap": 1, "barrel_on_ramp": true},
      {"id": 8, "code": "P", "name": "puente", "kind": "deck"},
      {"id": 9, "code": "G", "name": "puente_roto", "kind": "deck_gap", "min_speed": 3}
    ],
    "flight_segments": {"2": 2, "3": 3},
    "lane_layout": [
      {"name": "Carril 1 · Lodo", "ground": "....LLL.....LL......LLL.......", "deck": "------------------------------"},
      {"name": "Carril 2 · Agua", "ground": "......AA.....AA......AAA....A.", "deck": "------------------------------"},
      {"name": "Carril 3 · Pista incompleta", "ground": "...SSS..RFFA.....SSS...RFFA...", "deck": "------------------------------"},
      {"name": "Carril 4 · Rampas y puente", "ground": "...B..K...R.LLAA.FLL..K...B.R.", "deck": "------------PPPPPGPP----------"}
    ]
  },
  "perturbations": {
    "lluvia": {
      "descripcion": "Charcos y barro aparecen en carriles 1, 3 y 4.",
      "ground_overrides": [
        {"lane": 3, "segments": [20, 21, 24, 25], "code": "A"},
        {"lane": 2, "segments": [2, 3], "code": "A"},
        {"lane": 2, "segments": [27, 28, 29], "code": "L"},
        {"lane": 0, "segments": [8, 9], "code": "A"}
